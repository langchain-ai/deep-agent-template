# If unset, deepagents defaults are used. Set this to force a model.
DEEP_AGENT_MODEL=anthropic:claude-sonnet-4-6

# Required by your chosen model provider.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required for LangSmith sandboxes, and recommended for tracing.
LANGSMITH_API_KEY=lsv2_...

# Optional: idle seconds before a thread's sandbox is stopped (default 3600).
SANDBOX_IDLE_TTL_SECONDS=3600
